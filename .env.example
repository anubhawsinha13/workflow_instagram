# Copy this file to .env and fill in your API keys

# Perplexity API - For research and story generation
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI API - For script generation / optional DALL-E images
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini - Alternative for script + image generation
GEMINI_API_KEY=your_gemini_api_key_here
USE_GEMINI=true

# ElevenLabs API - For voiceover generation (used via Creatomate)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Creatomate API - For video generation
CREATOMATE_API_KEY=your_creatomate_api_key_here
CREATOMATE_TEMPLATE_ID=your_creatomate_template_id_here

# Optional: stock media fallbacks
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
